    function test_Basic_transfer_with_pause_and_lock_guards_0() public {
// assume: pause == false
// assume: am_I_locked(alice) == false
// cover: transfer :: require(!pause) true
// cover: transfer :: require(!lockAddresses[msg.sender]) true
// cover: transfer :: require(_value > 0) false
        vm.startPrank(owner);
        Grand target = new Grand();
        vm.stopPrank();
        vm.deal(owner, 100 ether);
        vm.deal(alice, 100 ether);
        vm.deal(bob,   100 ether);
        vm.deal(carol, 100 ether);
        vm.startPrank(owner);
        target.transfer(alice, 1000000000000000000);
        vm.stopPrank();
        uint256 balA0 = target.balanceOf(alice);
        uint256 balB0 = target.balanceOf(bob);
        uint256 balC0 = target.balanceOf(carol);
        uint256 balO0 = target.balanceOf(owner);
        uint256 ethA0 = alice.balance;
        uint256 ethB0 = bob.balance;
        uint256 ethC0 = carol.balance;
        uint256 ethO0 = owner.balance;
        uint256 supply0 = target.totalSupply();
        vm.startPrank(alice);
        {
        target.transfer(bob, 100000000000000000);
        }
        {
        target.transfer(carol, 0);
        }
        vm.stopPrank();
    }

