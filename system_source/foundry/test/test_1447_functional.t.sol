    function test_fundPuppets_normal_distribution_0() public {
// assume: msg.sender == owner
// assume: extra[0..3] are set to puppet addresses
// cover: fundPuppets :: require(msg.sender == owner) true
        vm.startPrank(owner);
        Splitter target = new Splitter();
        vm.stopPrank();
        vm.deal(owner, 100 ether);
        vm.deal(alice, 100 ether);
        vm.deal(bob,   100 ether);
        vm.deal(carol, 100 ether);
        uint256 ethA0 = alice.balance;
        uint256 ethB0 = bob.balance;
        uint256 ethC0 = carol.balance;
        uint256 ethO0 = owner.balance;
        vm.prank(owner);
        // skip ABI-mismatched call: fundPuppets()
    }

