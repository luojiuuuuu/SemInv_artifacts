    // @cover-intent Financial & Accounting: Verify investment during ICO period correctly allocates tokens and wallet balance.
    function test_Invest_During_ICO_5() public {
// assume: investStart > 1
// assume: block.number < investStart + (hashesSize * 5)
// assume: investBalance < investBalanceMax
// cover: invest :: normal investment
        vm.startPrank(alice);
        SmartBillions target = new SmartBillions();
        vm.stopPrank();
        vm.deal(owner, 100 ether);
        vm.deal(alice, 100 ether);
        vm.deal(bob,   100 ether);
        vm.deal(carol, 100 ether);
        target.addHashes(16384);
        // dropped unsafe prestate: target.setInvestStart(block.number + 100);
        uint256 balA0 = target.balanceOf(alice);
        uint256 balB0 = target.balanceOf(bob);
        uint256 balC0 = target.balanceOf(carol);
        uint256 balO0 = target.balanceOf(owner);
