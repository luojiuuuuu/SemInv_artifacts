        uint256 ethB0 = bob.balance;
        uint256 ethC0 = carol.balance;
        uint256 ethO0 = owner.balance;
        uint256 supply0 = target.totalSupply();
        uint256 allowAB0 = target.allowance(alice,bob);
        vm.startPrank(alice);
        {
        target.invest.value(10 ether)(owner);
        }
        {
        target.balanceOf(alice);
        }
        {
        target.walletBalanceOf(alice);
        }
        vm.stopPrank();
        vm.prank(owner);
        // skip ABI-mismatched call: investBalance()
        {
            uint256 __v1 = uint256(target.totalSupply());
            _assertRelU(__v1, 2, 10000, "call:totalSupply>=10000");
        }
        // TODO assert: call:investBalance() == 10 ether
    }

