        uint256 ethB0 = bob.balance;
        uint256 ethC0 = carol.balance;
        uint256 ethO0 = owner.balance;
        vm.startPrank(alice);
        // skip ABI-mismatched call: numberOfIndex()
        {
        target.indexarray(0);
        }
        vm.stopPrank();
    }

