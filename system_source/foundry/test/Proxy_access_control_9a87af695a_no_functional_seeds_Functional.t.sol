pragma solidity 0.4.26;
import "../src/proxy.sol";

// Foundry cheatcodes binding for Solidity 0.4.x
// 0.4 没有 interface，用抽象合约声明
contract Vm {
    function prank(address) public;
    function startPrank(address) public;
    function stopPrank() public;
    function deal(address, uint256) public;
    function expectRevert() public;
    function expectRevert(bytes) public;
    function store(address, bytes32, bytes32) public;
    function load(address, bytes32) public returns (bytes32);
}

contract Proxy_FunctionalTest {
    Vm constant vm = Vm(0x7109709ECfa91a80626fF3989D68f67F5b1DD12D);

    address owner;
    address alice;
    address bob;
    address carol;

    function Proxy_FunctionalTest() public {
        owner = address(0x0A0A);
        alice = address(0xA11CE);
        bob   = address(0xB0B);
        carol = address(0xCA1CE);
    }

    function() public payable { }


    // ---------- Helpers (0.4) ----------
    function _assertEqU(uint256 a, uint256 b) internal {
        require(a == b);
    }
    function _assertTrue(bool ok, string why) internal { require(ok); }
    function _assertRelU(uint256 a, uint8 op, uint256 b, string why) internal {
        // op: 0==,1!=,2>=,3<=,4>,5<
        if (op == 0) require(a == b);
        else if (op == 1) require(a != b);
        else if (op == 2) require(a >= b);
        else if (op == 3) require(a <= b);
        else if (op == 4) require(a >  b);
        else if (op == 5) require(a <  b);
    }
    function _assertApproxEqU(uint256 a, uint256 b, uint256 tol, string why) internal {
        if (a >= b) require(a - b <= tol); else require(b - a <= tol);
    }
    function _assertEqA(address a, address b) internal { require(a == b); }
    function _assertEqB32(bytes32 a, bytes32 b) internal { require(a == b); }
    function _assertEqS(string a, string b) internal { if (sha3(a) != sha3(b)) { require(false); } }


    // @cover-intent Authorization & Access Control: Verify that the owner can successfully call forward with a valid delegatecall to a trusted contract.
    function test_Basic_forward_call_from_owner_0() public {
// cover: forward :: require(callee.delegatecall(_data)) true
        vm.startPrank(owner);
        Proxy target = new Proxy();
        vm.stopPrank();
        vm.deal(owner, 100 ether);
        vm.deal(alice, 100 ether);
        vm.deal(bob,   100 ether);
        vm.deal(carol, 100 ether);
        uint256 ethA0 = alice.balance;
        uint256 ethB0 = bob.balance;
        uint256 ethC0 = carol.balance;
        uint256 ethO0 = owner.balance;
        vm.startPrank(owner);
        {
        target.forward(alice, hex"");
        }
        {
        target.forward(alice, hex"");
        }
        vm.stopPrank();
    }

    // @cover-intent Resource & Execution Integrity: Test that forward works with non-empty bytes data payload.
    function test_Forward_call_with_non_empty_data_1() public {
// cover: forward :: require(callee.delegatecall(_data)) true
        vm.startPrank(owner);
        Proxy target = new Proxy();
        vm.stopPrank();
        vm.deal(owner, 100 ether);
        vm.deal(alice, 100 ether);
        vm.deal(bob,   100 ether);
        vm.deal(carol, 100 ether);
        uint256 ethA0 = alice.balance;
        uint256 ethB0 = bob.balance;
        uint256 ethC0 = carol.balance;
        uint256 ethO0 = owner.balance;
        vm.startPrank(owner);
        {
        target.forward(alice, hex"aabbccdd");
        }
        {
        target.forward(alice, hex"aabbccdd");
        }
        vm.stopPrank();
    }

    // @cover-intent External Interaction & Environment: Test edge case where callee is the zero address, which will cause delegatecall to fail.
    function test_Forward_call_to_zero_address_2() public {
// cover: forward :: require(callee.delegatecall(_data)) false
        vm.startPrank(owner);
        Proxy target = new Proxy();
        vm.stopPrank();
        vm.deal(owner, 100 ether);
        vm.deal(alice, 100 ether);
        vm.deal(bob,   100 ether);
        vm.deal(carol, 100 ether);
        uint256 ethA0 = alice.balance;
        uint256 ethB0 = bob.balance;
        uint256 ethC0 = carol.balance;
        uint256 ethO0 = owner.balance;
        vm.expectRevert();
        vm.prank(owner);
        {
        target.forward(address(0), hex"");
        }
    }

    // @cover-intent Authorization & Access Control: Verify that any address can call forward (no access control), demonstrating the vulnerability.
    function test_Forward_call_from_non_owner_3() public {
// cover: forward :: require(callee.delegatecall(_data)) true
        vm.startPrank(owner);
        Proxy target = new Proxy();
        vm.stopPrank();
        vm.deal(owner, 100 ether);
        vm.deal(alice, 100 ether);
        vm.deal(bob,   100 ether);
        vm.deal(carol, 100 ether);
        uint256 ethA0 = alice.balance;
        uint256 ethB0 = bob.balance;
        uint256 ethC0 = carol.balance;
        uint256 ethO0 = owner.balance;
        vm.startPrank(alice);
        {
        target.forward(bob, hex"");
        }
        {
        target.forward(bob, hex"");
        }
        vm.stopPrank();
    }

    // @cover-intent Resource & Execution Integrity: Test behavior with a large bytes payload to check gas and execution limits.
    function test_Forward_with_large_data_payload_4() public {
// cover: forward :: require(callee.delegatecall(_data)) true
        vm.startPrank(owner);
        Proxy target = new Proxy();
        vm.stopPrank();
        vm.deal(owner, 100 ether);
        vm.deal(alice, 100 ether);
        vm.deal(bob,   100 ether);
        vm.deal(carol, 100 ether);
        uint256 ethA0 = alice.balance;
        uint256 ethB0 = bob.balance;
        uint256 ethC0 = carol.balance;
        uint256 ethO0 = owner.balance;
        vm.startPrank(owner);
        {
        target.forward(alice, hex"");
        }
        {
        target.forward(alice, hex"");
        }
        vm.stopPrank();
    }

    // @cover-intent Transactional Consistency: Verify that multiple forward calls can be made sequentially without state corruption.
    function test_Multiple_forward_calls_in_sequence_5() public {
// cover: forward :: require(callee.delegatecall(_data)) true
        vm.startPrank(owner);
        Proxy target = new Proxy();
        vm.stopPrank();
        vm.deal(owner, 100 ether);
        vm.deal(alice, 100 ether);
        vm.deal(bob,   100 ether);
        vm.deal(carol, 100 ether);
        uint256 ethA0 = alice.balance;
        uint256 ethB0 = bob.balance;
        uint256 ethC0 = carol.balance;
        uint256 ethO0 = owner.balance;
        vm.startPrank(owner);
        {
        target.forward(alice, hex"01");
        }
        {
        target.forward(bob, hex"02");
        }
        {
        target.forward(alice, hex"03");
        }
        {
        target.forward(bob, hex"04");
        }
        vm.stopPrank();
        vm.prank(alice);
        {
        target.forward(carol, hex"05");
        }
    }

    // @cover-intent minimal test for forward
    function test_perfn_forward_6() public {
        vm.startPrank(owner);
        Proxy target = new Proxy();
        vm.stopPrank();
        vm.deal(owner, 100 ether);
        vm.deal(alice, 100 ether);
        vm.deal(bob,   100 ether);
        vm.deal(carol, 100 ether);
        uint256 ethA0 = alice.balance;
        uint256 ethB0 = bob.balance;
        uint256 ethC0 = carol.balance;
        uint256 ethO0 = owner.balance;
        vm.prank(alice);
        {
        target.forward(alice, hex"01");
        }
    }

}
