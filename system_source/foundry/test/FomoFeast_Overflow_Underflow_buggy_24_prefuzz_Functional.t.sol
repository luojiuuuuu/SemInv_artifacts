        bob   = address(0xB0B);
        carol = address(0xCA1CE);
    }

    function() external payable { }


    // ---------- Helpers (0.5/0.6/0.7) ----------
    function _assertEqU(uint256 a, uint256 b) internal {
        require(a == b, "assertEqU failed");
    }
    function _assertTrue(bool ok, string memory why) internal { require(ok, why); }
    function _assertRelU(uint256 a, uint8 op, uint256 b, string memory why) internal {
        if (op == 0) require(a == b, why);
        else if (op == 1) require(a != b, why);
        else if (op == 2) require(a >= b, why);
        else if (op == 3) require(a <= b, why);
        else if (op == 4) require(a >  b, why);
        else if (op == 5) require(a <  b, why);
    }
    function _assertApproxEqU(uint256 a, uint256 b, uint256 tol, string memory why) internal {
        uint256 d = a >= b ? a - b : b - a;
        require(d <= tol, why);
    }
    function _assertEqA(address a, address b) internal { require(a == b, "addr eq"); }
    function _assertEqB32(bytes32 a, bytes32 b) internal { require(a == b, "b32 eq"); }
    function _assertEqS(string memory a, string memory b) internal {
        require(keccak256(abi.encodePacked(a)) == keccak256(abi.encodePacked(b)), "str eq");
    }


    // @cover-intent Protocol State Machine: Verify that initialize() sets up the genesis user and cannot be called twice.
    function test_Initialize_contract_and_verify_genesis_user_0() public {
// cover: initialize :: require(!initialized) true
// cover: initialize :: require(!initialized) false
        vm.startPrank(owner);
        FomoFeast target = new FomoFeast();
        vm.stopPrank();
        vm.deal(owner, 100 ether);
        vm.deal(alice, 100 ether);
        vm.deal(bob,   100 ether);
        vm.deal(carol, 100 ether);
        uint256 ethA0 = alice.balance;
        uint256 ethB0 = bob.balance;
        uint256 ethC0 = carol.balance;
        uint256 ethO0 = owner.balance;
        vm.startPrank(owner);
        // skip ABI-mismatched call: initialize()
        vm.expectRevert();
        // skip ABI-mismatched call: initialize()
        vm.stopPrank();
    }

    // @cover-intent Financial & Accounting: Verify that invest() correctly processes a valid investment and updates state.
    function test_Invest_with_valid_sponsor_and_cycle_1() public {
// cover: invest :: require(sponsor.totalInvestCount > 0) true
// cover: invest :: require(investCycle == 30 || investCycle == 60 || investCycle == 90) true
// cover: invest :: require(investAmount == msg.value) true
// cover: invest :: require(investAmount >= ONE_ETH.mul(1) && investAmount <= ONE_ETH.mul(15)) true
// cover: invest :: require(user.totalInvestCount > 0) true
// cover: invest :: require(user.currentInvestAmount == 0) false
        vm.startPrank(alice);
        FomoFeast target = new FomoFeast();
        vm.stopPrank();
        vm.deal(owner, 100 ether);
        vm.deal(alice, 100 ether);
        vm.deal(bob,   100 ether);
        vm.deal(carol, 100 ether);
        uint256 ethA0 = alice.balance;
        uint256 ethB0 = bob.balance;
        uint256 ethC0 = carol.balance;
        uint256 ethO0 = owner.balance;
        vm.prank(owner);
        // skip ABI-mismatched call: initialize()
        vm.startPrank(alice);
        {
        target.invest.value(1 ether)(0xe00d13D53Ba180EAD5F4838BD56b15629026A8C9, 30);
        }
        vm.expectRevert();
        {
        target.invest.value(1 ether)(0xe00d13D53Ba180EAD5F4838BD56b15629026A8C9, 30);
        }
        vm.stopPrank();
        {
            uint256 __v1 = uint256(target.totalInvestCount());
            _assertRelU(__v1, 0, 1, "call:totalInvestCount==1");
        }
        // TODO assert: call:totalInvestAmount() == 1 ether
    }

