    // @cover-intent state transition test for halt
    function test_IEO_Halt_And_Unhalt_8() public {
// assume: msg.sender == admin for halt/unhalt positive paths
// cover: halt :: require(msg.sender == admin) true
// cover: halt :: require(msg.sender == admin) false
// cover: unhalt :: require(msg.sender == admin) true
// cover: unhalt :: require(msg.sender == admin) false
        vm.startPrank(owner);
        AcunarIEO target = new AcunarIEO(address(uint160(alice)));
        vm.stopPrank();
        vm.deal(owner, 100 ether);
        vm.deal(alice, 100 ether);
        vm.deal(bob,   100 ether);
        vm.deal(carol, 100 ether);
        vm.store(address(target), bytes32(uint256(0)), bytes32(uint256(2)));
        uint256 balA0 = target.balanceOf(alice);
        uint256 balB0 = target.balanceOf(bob);
        uint256 balC0 = target.balanceOf(carol);
        uint256 balO0 = target.balanceOf(owner);
        uint256 ethA0 = alice.balance;
        uint256 ethB0 = bob.balance;
        uint256 ethC0 = carol.balance;
        uint256 ethO0 = owner.balance;
        uint256 supply0 = target.totalSupply();
        uint256 allowAB0 = target.allowance(alice,bob);
        vm.expectRevert();
        vm.prank(alice);
        {
        target.halt();
        }
        vm.prank(owner);
        {
        target.halt();
        }
        vm.expectRevert();
        vm.prank(alice);
        {
        target.unhalt();
        }
        vm.prank(owner);
        {
        target.unhalt();
        }
        {
            uint256 __v1 = uint256(target.ieoState());
            _assertRelU(__v1, 0, 2, "call:ieoState==2");
        }
    }

