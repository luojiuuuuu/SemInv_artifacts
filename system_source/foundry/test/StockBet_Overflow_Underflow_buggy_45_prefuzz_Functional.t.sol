        {
        target.setOracle(alice);
        }
        vm.prank(alice);
        {
        target.setInitialPrice(100);
        }
        vm.prank(bob);
        // skip ABI-mismatched call: betUp()
        vm.startPrank(owner);
        // skip ABI-mismatched call: closeGame()
        {
        target.setFinalPrice(50);
        }
        // skip ABI-mismatched call: collectOwnerWinnings()
        vm.stopPrank();
    }

