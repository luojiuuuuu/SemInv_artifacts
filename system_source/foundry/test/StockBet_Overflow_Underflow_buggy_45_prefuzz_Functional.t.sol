    function test_Owner_Wins_Path_No_Players_Bet_on_Correct_Direction_1() public {
// assume: state == State.OPEN
// assume: finalPrice < initialPrice => result = DOWN
// assume: guesses[DOWN].guesses_number == 0
// cover: setFinalPrice :: finalPrice <= initialPrice => result = DOWN
// cover: setFinalPrice :: guesses[result].guesses_number == 0 => state = OWNER_WIN
// cover: collectOwnerWinnings :: byOwner and inState(OWNER_WIN)
        vm.startPrank(owner);
        StockBet target = new StockBet(1);
        vm.stopPrank();
        vm.deal(owner, 100 ether);
        vm.deal(alice, 100 ether);
        vm.deal(bob,   100 ether);
        vm.deal(carol, 100 ether);
        uint256 ethA0 = alice.balance;
