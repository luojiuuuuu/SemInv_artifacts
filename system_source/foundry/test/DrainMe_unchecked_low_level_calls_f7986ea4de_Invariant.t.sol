contract DrainMeLegacyPropertyTest is SimpleAssert, LegacyCheatcodes {
    DrainMe target;
    DrainMeHandler handler;

    function setUp() public {
        target = new DrainMe();
        handler = new DrainMeHandler(target);
        _vm().deal(address(handler), 100 ether);
    }

    function _run_basic_sequence() internal {
        handler.call_DranMe();
        handler.call_setSecret(1);
        handler.call_becomePlayer();
        handler.call_manipulateSecret();
        handler.call_callFirstTarget();
        handler.call_callSecondTarget();
        handler.call_setSeed(1, 1);
        handler.call_addSeed(1);
        handler.call_guessSeed(1);
        handler.call_checkSecret();
        handler.call_winPrize();
        handler.call_claimPrize();
    }
}
