        uint256 ethC0 = carol.balance;
        uint256 ethO0 = owner.balance;
        vm.startPrank(alice);
        // skip ABI-mismatched call: deposit()
        vm.expectRevert();
        {
        target.withdraw(10);
        }
        vm.stopPrank();
        // TODO assert: alice.balance == 20
    }

    // @cover-intent Authorization & Access Control: Verify that only the owner (creator) can call migrateTo.
    function test_migrateTo_owner_only_3() public {
