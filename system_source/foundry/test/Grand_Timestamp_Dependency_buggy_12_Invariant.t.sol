contract GrandLegacyPropertyTest is SimpleAssert, LegacyCheatcodes {
    Grand target;
    GrandHandler handler;

    function setUp() public {
        target = new Grand();
        handler = new GrandHandler(target);
        _vm().deal(address(handler), 100 ether);
    }

    function _run_basic_sequence() internal {
        handler.call_transfer(address(0x1001), 1);
        handler.call_play_tmstmp19(1);
        handler.call_play_tmstmp26(1);
        handler.call_play_tmstmp15(1);
        handler.call_bug_tmstmp20();
        handler.call_bug_tmstmp32();
        handler.call_play_tmstmp38(1);
        handler.call_bug_tmstmp28();
        handler.call_bug_tmstmp4();
        handler.call_play_tmstmp34(1);
        handler.call_play_tmstmp10(1);
        handler.call_play_tmstmp22(1);
        handler.call_bug_tmstmp12();
        handler.call_play_tmstmp7(1);
        handler.call_changeOwner(address(0x1001));
        handler.call_play_tmstmp23(1);
        handler.call_pauseContract();
        handler.call_play_tmstmp14(1);
        handler.call_resumeContract();
        handler.call_play_tmstmp30(1);
        handler.call_bug_tmstmp8();
        handler.call_lock(address(0x1001));
        handler.call_play_tmstmp39(1);
        handler.call_unlock(address(0x1001));
        handler.call_bug_tmstmp36();
        handler.call_play_tmstmp35(1);
        handler.call_bug_tmstmp40();
        handler.call_getETH(1);
        handler.call_play_tmstmp27(1);
        handler.call_play_tmstmp31(1);
        handler.call_transferAnyERC20Token(address(0x1001), 1);
    }

    function test_property_access_changeOwner() public {
        address attacker = address(0xdead);
        _vm().startPrank(attacker);
        bool ok = address(target).call(abi.encodeWithSignature("changeOwner(address)", address(0x1001)));
        _vm().stopPrank();
        _assertTrue(!ok);
    }

    function test_property_access_pauseContract() public {
        address attacker = address(0xdead);
        _vm().startPrank(attacker);
        bool ok = address(target).call(abi.encodeWithSignature("pauseContract()"));
        _vm().stopPrank();
        _assertTrue(!ok);
    }

    function test_property_access_resumeContract() public {
        address attacker = address(0xdead);
        _vm().startPrank(attacker);
        bool ok = address(target).call(abi.encodeWithSignature("resumeContract()"));
        _vm().stopPrank();
        _assertTrue(!ok);
    }
}