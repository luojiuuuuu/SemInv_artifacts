    function test_init_and_single_owner_execute_under_limit_0() public {
// cover: execute :: m_required == 1
        vm.startPrank(owner);
        WalletLibrary target = new WalletLibrary();
        vm.stopPrank();
        vm.deal(owner, 100 ether);
        vm.deal(alice, 100 ether);
        vm.deal(bob,   100 ether);
        vm.deal(carol, 100 ether);
        uint256 ethA0 = alice.balance;
        uint256 ethB0 = bob.balance;
        uint256 ethC0 = carol.balance;
        uint256 ethO0 = owner.balance;
        vm.startPrank(alice);
        {
        address[] memory _arr1 = new address[](0);
        target.initWallet(_arr1, 1, 100);
        }
        // skip ABI-mismatched call: m_spentToday()
        vm.stopPrank();
        // TODO assert: alice.balance == 100
    }

