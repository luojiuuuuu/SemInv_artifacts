    // @cover-intent Financial & Accounting: Verify calculateBonus returns correct values at boundaries (timeElasped = 0, minAgeOfToken, maxAgeOfToken).
    function test_CalculateBonus_Edge_Cases_10() public {
// assume: minAgeOfToken() == 86400
// assume: maxAgeOfToken() == 31536000
// assume: perDayBonus() == 100
// cover: calculateBonus :: totalDays > maxAgeOfToken true
// cover: calculateBonus :: totalDays > maxAgeOfToken false
        vm.startPrank(owner);
        LollypopToken target = new LollypopToken();
        vm.stopPrank();
        vm.deal(owner, 100 ether);
        vm.deal(alice, 100 ether);
        vm.deal(bob,   100 ether);
        vm.deal(carol, 100 ether);
        uint256 balA0 = target.balanceOf(alice);
        uint256 balB0 = target.balanceOf(bob);
        uint256 balC0 = target.balanceOf(carol);
        uint256 balO0 = target.balanceOf(owner);
        uint256 ethA0 = alice.balance;
        uint256 ethB0 = bob.balance;
        uint256 ethC0 = carol.balance;
        uint256 ethO0 = owner.balance;
        uint256 supply0 = target.totalSupply();
        uint256 allowAB0 = target.allowance(alice,bob);
        vm.startPrank(alice);
        {
        target.calculateBonus(0, 1000);
        }
        {
        target.calculateBonus(86400, 1000);
        }
        {
        target.calculateBonus(31536000, 1000);
        }
        vm.stopPrank();
        {
            uint256 __v1 = uint256(target.calculateBonus(0, 1000));
            _assertRelU(__v1, 0, 0, "call:calculateBonus==0");
        }
        {
            uint256 __v2 = uint256(target.calculateBonus(86400, 1000));
            _assertRelU(__v2, 0, 10000, "call:calculateBonus==10000");
        }
        {
            uint256 __v3 = uint256(target.calculateBonus(31536000, 1000));
            _assertRelU(__v3, 0, 315360000, "call:calculateBonus==315360000");
        }
    }

