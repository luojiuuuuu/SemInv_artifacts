pragma solidity 0.4.26;
import "../src/simple_ether_drain.sol";

// Foundry cheatcodes binding for Solidity 0.4.x
// 0.4 没有 interface，用抽象合约声明
contract Vm {
    function prank(address) public;
    function startPrank(address) public;
    function stopPrank() public;
    function deal(address, uint256) public;
    function expectRevert() public;
    function expectRevert(bytes) public;
    function store(address, bytes32, bytes32) public;
    function load(address, bytes32) public returns (bytes32);
}

contract SimpleEtherDrain_FunctionalTest {
    Vm constant vm = Vm(0x7109709ECfa91a80626fF3989D68f67F5b1DD12D);

    address owner;
    address alice;
    address bob;
    address carol;

    function SimpleEtherDrain_FunctionalTest() public {
        owner = address(0x0A0A);
        alice = address(0xA11CE);
        bob   = address(0xB0B);
        carol = address(0xCA1CE);
    }

    function() public payable { }


    // ---------- Helpers (0.4) ----------
    function _assertEqU(uint256 a, uint256 b) internal {
        require(a == b);
    }
    function _assertTrue(bool ok, string why) internal { require(ok); }
    function _assertRelU(uint256 a, uint8 op, uint256 b, string why) internal {
        // op: 0==,1!=,2>=,3<=,4>,5<
        if (op == 0) require(a == b);
        else if (op == 1) require(a != b);
        else if (op == 2) require(a >= b);
        else if (op == 3) require(a <= b);
        else if (op == 4) require(a >  b);
        else if (op == 5) require(a <  b);
    }
    function _assertApproxEqU(uint256 a, uint256 b, uint256 tol, string why) internal {
        if (a >= b) require(a - b <= tol); else require(b - a <= tol);
    }
    function _assertEqA(address a, address b) internal { require(a == b); }
    function _assertEqB32(bytes32 a, bytes32 b) internal { require(a == b); }
    function _assertEqS(string a, string b) internal { if (sha3(a) != sha3(b)) { require(false); } }


    // @cover-intent Financial & Accounting: Verify that withdrawAllAnyone sends the entire contract balance to the caller.
    function test_Positive_owner_withdraws_all_ETH_0() public {
// assume: address(this).balance >= 0
// cover: withdrawAllAnyone :: transfer succeeds
        vm.startPrank(owner);
        SimpleEtherDrain target = new SimpleEtherDrain();
        vm.stopPrank();
        vm.deal(owner, 100 ether);
        vm.deal(alice, 100 ether);
        vm.deal(bob,   100 ether);
        vm.deal(carol, 100 ether);
        uint256 ethA0 = alice.balance;
        uint256 ethB0 = bob.balance;
        uint256 ethC0 = carol.balance;
        uint256 ethO0 = owner.balance;
        vm.prank(alice);
        // skip ABI-mismatched call: withdrawAllAnyone()
    }

    // @cover-intent Resource & Execution Integrity: Verify that withdrawAllAnyone does not revert when balance is zero (transfer of 0 should succeed).
    function test_Edge_withdraw_when_contract_balance_is_zero_1() public {
// assume: address(this).balance == 0
// cover: withdrawAllAnyone :: balance == 0
        vm.startPrank(owner);
        SimpleEtherDrain target = new SimpleEtherDrain();
        vm.stopPrank();
        vm.deal(owner, 100 ether);
        vm.deal(alice, 100 ether);
        vm.deal(bob,   100 ether);
        vm.deal(carol, 100 ether);
        uint256 ethA0 = alice.balance;
        uint256 ethB0 = bob.balance;
        uint256 ethC0 = carol.balance;
        uint256 ethO0 = owner.balance;
        vm.prank(alice);
        // skip ABI-mismatched call: withdrawAllAnyone()
    }

    // @cover-intent Authorization & Access Control: Verify that any caller (bob) can withdraw the entire balance, not just the depositor.
    function test_Edge_multiple_callers_can_withdraw_2() public {
// assume: address(this).balance == 3 ether
// cover: withdrawAllAnyone :: caller is not depositor
        vm.startPrank(owner);
        SimpleEtherDrain target = new SimpleEtherDrain();
        vm.stopPrank();
        vm.deal(owner, 100 ether);
        vm.deal(alice, 100 ether);
        vm.deal(bob,   100 ether);
        vm.deal(carol, 100 ether);
        uint256 ethA0 = alice.balance;
        uint256 ethB0 = bob.balance;
        uint256 ethC0 = carol.balance;
        uint256 ethO0 = owner.balance;
        vm.prank(bob);
        // skip ABI-mismatched call: withdrawAllAnyone()
    }

    // @cover-intent Financial & Accounting: Verify that withdrawAllAnyone drains the entire accumulated balance from multiple depositors.
    function test_Boundary_withdraw_after_multiple_deposits_3() public {
// assume: address(this).balance == 5 ether
// cover: withdrawAllAnyone :: multiple deposits
        vm.startPrank(owner);
        SimpleEtherDrain target = new SimpleEtherDrain();
        vm.stopPrank();
        vm.deal(owner, 100 ether);
        vm.deal(alice, 100 ether);
        vm.deal(bob,   100 ether);
        vm.deal(carol, 100 ether);
        uint256 ethA0 = alice.balance;
        uint256 ethB0 = bob.balance;
        uint256 ethC0 = carol.balance;
        uint256 ethO0 = owner.balance;
        vm.prank(carol);
        // skip ABI-mismatched call: withdrawAllAnyone()
    }

    // @cover-intent Financial & Accounting
    function test_withdrawAllAnyone_basic_4() public {
        vm.startPrank(owner);
        SimpleEtherDrain target = new SimpleEtherDrain();
        vm.stopPrank();
        vm.deal(owner, 100 ether);
        vm.deal(alice, 100 ether);
        vm.deal(bob,   100 ether);
        vm.deal(carol, 100 ether);
        uint256 ethA0 = alice.balance;
        uint256 ethB0 = bob.balance;
        uint256 ethC0 = carol.balance;
        uint256 ethO0 = owner.balance;
        vm.prank(bob);
        // skip ABI-mismatched call: withdrawAllAnyone()
        // TODO assert: alice.balance == 0
    }

}
