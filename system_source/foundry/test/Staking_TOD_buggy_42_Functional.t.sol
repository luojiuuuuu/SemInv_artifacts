    function test_staking_positive_path_0() public {
// assume: balanceOf(alice) >= 5500000000000
// assume: balanceOf(owner) >= 1500000000000
// cover: startStaking :: require(balance >= stakeTokens + fee) true
// cover: redeem :: require(time + stakeTime <= now) true
// cover: redeem :: require(!lock) true
// cover: redeem :: require(!redeem) true
        vm.startPrank(owner);
        Staking target = new Staking(alice);
        vm.stopPrank();
        vm.deal(owner, 100 ether);
        vm.deal(alice, 100 ether);
        vm.deal(bob,   100 ether);
        vm.deal(carol, 100 ether);
        uint256 ethA0 = alice.balance;
        uint256 ethB0 = bob.balance;
        uint256 ethC0 = carol.balance;
        uint256 ethO0 = owner.balance;
        vm.startPrank(alice);
        {
        target.startStaking();
        }
        vm.expectRevert();
        {
        target.redeem();
        }
        vm.stopPrank();
        vm.prank(owner);
        // skip malformed call: changeStakeTime(uint256 0) (bad raw arg for changeStakeTime.arg0: type=uint256, raw=uint256 0)
        vm.prank(alice);
        {
        target.redeem();
        }
        // TODO assert: alice.balance == 5000000000000
    }

