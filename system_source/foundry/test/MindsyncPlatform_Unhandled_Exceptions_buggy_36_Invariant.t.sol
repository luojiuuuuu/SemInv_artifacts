contract MindsyncPlatformLegacyTerminalSupplementTest is MindsyncPlatformBasePropertyTest {

    function test_supplement_initialized_terminal_absorbing() public {
        // invariant: I3.state.terminal_absorbing
        _run_basic_sequence();
        if(handler.entered_terminal_initialized()) {
            uint256 curr = handler.curr_initialized();
            _assertTrue(curr == 1);
        }
    }

    function test_supplement_payedOut_unchk44_terminal_absorbing() public {
        // invariant: I3.state.terminal_absorbing
        _run_basic_sequence();
        if(handler.entered_terminal_payedOut_unchk44()) {
            uint256 curr = handler.curr_payedOut_unchk44();
            _assertTrue(curr == 1);
        }
    }

    function test_supplement_payedOut_unchk8_terminal_absorbing() public {
        // invariant: I3.state.terminal_absorbing
        _run_basic_sequence();
        if(handler.entered_terminal_payedOut_unchk8()) {
            uint256 curr = handler.curr_payedOut_unchk8();
            _assertTrue(curr == 1);
        }
    }
}

contract MindsyncPlatformLegacyEthFlowSupplementTest is MindsyncPlatformBasePropertyTest {

    function test_supplement_eth_balance_bound_0_winAmount_unchk44() public {
        // invariant: I1.accounting.eth_balance_consistency
        _run_basic_sequence();
        _assertTrue(target.winAmount_unchk44() <= address(target).balance);
    }

    function test_supplement_eth_balance_bound_1_winAmount_unchk8() public {
        // invariant: I1.accounting.eth_balance_consistency
        _run_basic_sequence();
        _assertTrue(target.winAmount_unchk8() <= address(target).balance);
    }
}
